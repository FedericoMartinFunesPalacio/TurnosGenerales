# =============================================
# Variables de entorno — Backend Turnos
# =============================================
# Copia este archivo como .env y completa los valores.
# En Render se configuran en el dashboard del servicio (Environment).
# =============================================

# Puerto del servidor (Render lo inyecta automaticamente)
PORT=3000

# DATABASE_URL: URL de conexion a PostgreSQL
# Local (docker-compose): "postgresql://turnos:turnos@localhost:5432/turnosdb"
# Render: la URL que genera Render al crear la Base de Datos
DATABASE_URL="postgresql://turnos:turnos@localhost:5432/turnosdb"

# EMAIL_USER: Email de Gmail para enviar notificaciones
EMAIL_USER=tu-email@gmail.com

# EMAIL_PASS: App Password de Google (16 caracteres, requiere 2FA)
# Se genera en: https://myaccount.google.com/apppasswords
EMAIL_PASS=tu-app-password

# CORS_ORIGINS: origenes permitidos por CORS (separados por coma)
# Debe incluir la URL de GitHub Pages del frontend
# Ejemplo: "http://localhost:4200,https://tuusuario.github.io"
CORS_ORIGINS="http://localhost:4200,https://tuusuario.github.io"

# =============================================
# Supabase Storage (documentos de turnos)
# =============================================

# SUPABASE_URL: URL del proyecto de Supabase
# Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# SUPABASE_SERVICE_ROLE_KEY: clave service_role del proyecto
# Supabase Dashboard -> Project Settings -> API -> service_role
# OJO: es un secreto de SOLO SERVIDOR (da acceso total al storage).
# Nunca la pongas en el frontend ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=clave-service-role

# SUPABASE_BUCKET: bucket PRIVADO de Storage donde viven los documentos
# Se crea una sola vez: Supabase Dashboard -> Storage -> New bucket -> "documentos" (Private)
SUPABASE_BUCKET=documentos

# CLEANUP_TOKEN: secreto compartido del endpoint POST /api/v1/upload/cleanup
# Genera uno random (ej: openssl rand -hex 16) y usalo igual en:
#   - Render -> Environment -> CLEANUP_TOKEN
#   - GitHub -> Settings -> Secrets and variables -> Actions -> CLEANUP_TOKEN
CLEANUP_TOKEN=token-random-largo
